# Copy this file to .env and fill in real values. .env is gitignored.

# PostgreSQL connection string.
# Local dev: run `npx prisma dev` in a separate terminal, it prints a URL to paste here.
# Production: use a hosted Postgres (Neon, Supabase, Railway Postgres, etc.)
# Keep `pgbouncer=true` - it disables Prisma's prepared-statement caching, which
# avoids "prepared statement already exists" errors against connection poolers
# (including the one `prisma dev` uses locally, and most hosted pooled Postgres URLs).
# Keep `connection_limit` capped too - `prisma dev`'s local database (and most
# hosted pooled Postgres URLs) reject connections beyond a fairly low ceiling,
# and a live session's burst of concurrent queries can exceed Prisma's own
# uncapped default pool size and fail with "Can't reach database server".
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true&connection_limit=5&pool_timeout=20"

# Local dev only, used by `prisma migrate dev` to test a migration before
# applying it for real - point it at a spare database name on the same
# server. Not read by `prisma migrate deploy`, so production doesn't need it.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51214/skillarena_shadow?sslmode=disable&connection_limit=5&pool_timeout=20"

# Used ONLY once, by `npm run db:seed`, to create the first admin User row
# (hashed - not stored in plaintext). After that, admins are managed from the
# admin dashboard itself, not from environment variables. Change the password
# after first login.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Random secret used to sign the admin session cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string"

# Public URL students' phones will hit when they scan the QR code.
# Must be reachable from their network - e.g. your Railway/Render URL in production.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
